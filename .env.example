# ActiveCampaign (formularer). Uden URL og nøgle sendes intet – formularerne svarer "ok" lokalt.
# Sættes i Vercel → Settings → Environment Variables. Nøglen findes i ActiveCampaign → Settings → Developer.
ACTIVECAMPAIGN_URL=https://tobaadvice24097.api-us1.com
ACTIVECAMPAIGN_KEY=

# Lister (id'er). "Leads" får alle henvendelser; nyhedsbrevet kun ved samtykke til markedsføring.
AC_LIST_LEADS=6
AC_LIST_NEWSLETTER=3

# Tags (navne – oprettes automatisk, hvis de ikke findes).
AC_TAG_KONTAKT=Website Formular
AC_TAG_GUIDE=Lagkage
AC_TAG_OMKOSTNINGSOVERBLIK=omkostningsoverblik
AC_TAG_MOEDE=book et møde
AC_TAG_MARKETING_CONSENT=SamtykkeTilMarkedsføring

# Google Analytics 4 (målings-ID "G-…" fra GA → Administrator → Datastrømme). Uden ID indlæses intet.
# Sættes kun under "Production" i Vercel. GA indlæses kun med samtykke til statistik.
NEXT_PUBLIC_GA_ID=G-508HFMTYFG
# Domæner, der må måles (kommasepareret). Standard: tobaadvice.com,www.tobaadvice.com.
# Sæt midlertidigt til toba-two.vercel.app for at teste før domæneskiftet – og fjern det igen.
NEXT_PUBLIC_ANALYTICS_HOSTS=

# Google Search Console – kun hvis domænet bekræftes med "HTML-tag" i stedet for DNS (kun selve koden fra content="…").
GOOGLE_SITE_VERIFICATION=
